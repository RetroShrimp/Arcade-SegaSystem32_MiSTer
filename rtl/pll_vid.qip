set_global_assignment -name SYNTHESIS_ONLY_QIP ON

set_global_assignment -library "pll_vid" -name VERILOG_FILE [file join $::quartus(qip_path) "pll_vid.v"]
set_global_assignment -library "pll_vid" -name VERILOG_FILE [file join $::quartus(qip_path) "pll_vid/pll_vid_0002.v"]

set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pll_vid_0002*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_AUTO_RESET ON -to "*pll_vid_0002*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*pll_vid_0002*|altera_pll:altera_pll_i*|*"
