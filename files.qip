# Add source files here, never through the Quartus GUI. sys/ (the MiSTer
# framework) is pulled in by sys/sys.tcl from S32.qsf.

set_global_assignment -name SDC_FILE S32.sdc
set_global_assignment -name SYSTEMVERILOG_FILE S32.sv

set_global_assignment -name QIP_FILE rtl/pll.qip

